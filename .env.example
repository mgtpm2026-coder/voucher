# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env.
# Generate a secret key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The app refuses to start if SECRET_KEY is missing or left as the placeholder.
# ---------------------------------------------------------------------------
SECRET_KEY=

DB_HOST=localhost
DB_PORT=3306
DB_USER=voucher_app
DB_PASSWORD=
DB_NAME=voucher_db
DB_POOL_SIZE=8
DB_TIME_ZONE=+05:30

UPLOAD_FOLDER=uploads
LOG_DIR=logs
MAX_UPLOAD_MB=10
PER_PAGE=50
SESSION_HOURS=8

# Bind address for the built-in dev server. Use 127.0.0.1 locally; in
# production run gunicorn behind nginx instead of this server.
BIND_HOST=127.0.0.1
PORT=5000

# Set to 0 ONLY for local plain-HTTP development. Must be 1 in production so
# the session cookie is never sent over an unencrypted connection.
COOKIE_SECURE=1

# Set to 1 only when running behind a reverse proxy you control, so
# X-Forwarded-For can be trusted for rate limiting.
TRUST_PROXY=0

# --- SMS / WhatsApp (Twilio) - OTP verification & voucher alerts ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
DEFAULT_COUNTRY_CODE=+91

# --- Email (SMTP) - voucher alerts ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
