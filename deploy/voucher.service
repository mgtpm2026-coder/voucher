# /etc/systemd/system/voucher.service
# sudo systemctl daemon-reload && sudo systemctl enable --now voucher
[Unit]
Description=MGT Voucher Management
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=voucher
Group=voucher
WorkingDirectory=/opt/voucher
Environment="PATH=/opt/voucher/.venv/bin"
EnvironmentFile=/opt/voucher/.env
ExecStart=/opt/voucher/.venv/bin/gunicorn -c deploy/gunicorn.conf.py app:app
Restart=always
RestartSec=5

# The app only ever writes to uploads/ and logs/.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/voucher/uploads /opt/voucher/logs

[Install]
WantedBy=multi-user.target
